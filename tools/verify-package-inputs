#!/usr/bin/env python3
"""Reject release package manifests that depend on untracked local files."""

from __future__ import annotations

import re
import subprocess
from pathlib import Path


GENERATED_INPUTS = (
    "data/ephe",
    "data/geonames",
    "target/release/meridian",
)


def package_sources(root: Path) -> set[str]:
    cargo = (root / "Cargo.toml").read_text(encoding="utf-8")
    icons = re.search(r"(?ms)^icons\s*=\s*\[(.*?)^\]", cargo)
    if icons is None:
        raise SystemExit("Cargo packager metadata has no icon list")
    sources = set(re.findall(r'"([^"]+)"', icons.group(1)))

    resources = re.findall(
        r'(?ms)^\[\[package\.metadata\.packager\.resources\]\]\s*^src\s*=\s*"([^"]+)"',
        cargo,
    )
    if not resources:
        raise SystemExit("Cargo packager metadata has no resources")
    sources.update(resources)

    installer_icon = re.search(
        r'(?ms)^\[package\.metadata\.packager\.nsis\].*?^installer-icon\s*=\s*"([^"]+)"',
        cargo,
    )
    if installer_icon is None:
        raise SystemExit("Cargo packager metadata has no NSIS installer icon")
    sources.add(installer_icon.group(1))

    nfpm = (root / "packaging" / "nfpm.yaml").read_text(encoding="utf-8")
    sources.update(
        value.strip().strip('"\'')
        for value in re.findall(r"^\s*-\s+src:\s+(.+?)\s*$", nfpm, re.MULTILINE)
    )
    return sources


def is_generated(source: str) -> bool:
    normalized = source.rstrip("/")
    return any(
        normalized == prefix or normalized.startswith(f"{prefix}/")
        for prefix in GENERATED_INPUTS
    )


def tracked_files(root: Path) -> set[str]:
    result = subprocess.run(
        ["git", "-c", f"safe.directory={root}", "ls-files", "-z"],
        cwd=root,
        check=True,
        capture_output=True,
    )
    return {
        path.decode("utf-8")
        for path in result.stdout.split(b"\0")
        if path
    }


def main() -> None:
    root = Path(__file__).resolve().parent.parent
    tracked = tracked_files(root)
    missing = []
    for source in sorted(package_sources(root)):
        if is_generated(source):
            continue
        normalized = source.rstrip("/")
        if not (root / normalized).is_file() or normalized not in tracked:
            missing.append(normalized)

    if missing:
        formatted = "\n".join(f"  - {path}" for path in missing)
        raise SystemExit(
            "release package manifests reference missing or untracked files:\n"
            f"{formatted}"
        )

    print("verified all static release package inputs are tracked")


if __name__ == "__main__":
    main()
