#!/usr/bin/env sh
set -eu

revision=3fd0f956d73898b91cc4f67cf18b21af656d1342
base_url="https://raw.githubusercontent.com/aloistr/swisseph/$revision/ephe"
destination=${MERIDIAN_EPHE_PATH:-data/ephe}
scope=${1:---current}

case "$scope" in
  --current|--all) ;;
  *)
    echo "usage: $0 [--current|--all]" >&2
    exit 2
    ;;
esac

mkdir -p "$destination"
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM

download() {
  name=$1
  expected=${2:-}
  target="$destination/$name"

  if [ -f "$target" ]; then
    if [ -z "$expected" ] || printf '%s  %s\n' "$expected" "$target" | sha256sum -c - >/dev/null 2>&1; then
      return
    fi
    echo "refusing to replace ephemeris file with an unexpected digest: $target" >&2
    exit 1
  fi

  echo "fetching $name"
  curl --fail --location --silent --show-error "$base_url/$name" --output "$temporary/$name"
  if [ -n "$expected" ]; then
    printf '%s  %s\n' "$expected" "$temporary/$name" | sha256sum -c - >/dev/null
  fi
  install -m 0644 "$temporary/$name" "$target"
}

download sepl_18.se1 ca1393ceab3a44fbc895887cf789c68819ae6a1cbc9b22225872dbe4ccd99a66
download semo_18.se1 1ca07bd67c24374d77226180c20a4f9996cba013697894810518e7eb582ca4f7

if [ "$scope" = "--all" ]; then
  start=0
  while [ "$start" -le 168 ]; do
    suffix=$(printf '%02d' "$start")
    download "sepl_$suffix.se1"
    download "semo_$suffix.se1"
    start=$((start + 6))
  done

  start=6
  while [ "$start" -le 132 ]; do
    suffix=$(printf 'm%02d' "$start")
    download "sepl$suffix.se1"
    download "semo$suffix.se1"
    start=$((start + 6))
  done
fi

echo "ephemeris ready at $destination ($scope, revision $revision)"

